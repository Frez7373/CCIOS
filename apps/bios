-- ============================================================
-- CCI BIOS SETUP UTILITY
-- Compact, BIOS-like firmware interface for CC:Tweaked
-- Standalone: no external APIs or libraries.
-- ============================================================

local BIOS_VERSION = "2.1.0"
local CFG = "/.cci_bios.cfg"

local bootCandidates = {
    {path="/startup",       name="CC:Tweaked startup"},
    {path="/boot.lua",      name="Boot loader"},
    {path="/os.lua",        name="Operating system"},
    {path="/system/startup",name="System startup"},
    {path="/system/boot.lua",name="System boot loader"}
}

local pages = {"MAIN", "ADVANCED", "BOOT", "SECURITY", "EXIT"}
local page = 1
local item = 1
local bootItem = 1
local savedBoot = nil
local selectedBoot = nil

local BG = colors.blue
local PANEL = colors.lightGray
local FG = colors.black
local WHITE = colors.white
local MUTED = colors.gray
local SELECT = colors.gray
local BLUE = colors.blue
local GREEN = colors.lime
local RED = colors.red
local YELLOW = colors.yellow

local function W()
    return term.getSize()
end

local function H()
    return select(2, term.getSize())
end

local function cls(bg)
    term.setBackgroundColor(bg or BG)
    term.setTextColor(WHITE)
    term.clear()
    term.setCursorPos(1,1)
end

local function put(x,y,s,fg,bg)
    term.setCursorPos(x,y)
    if bg then term.setBackgroundColor(bg) end
    if fg then term.setTextColor(fg) end
    write(tostring(s or ""))
end

local function blank(y,bg)
    put(1,y,string.rep(" ",W()),FG,bg or BG)
end

local function fit(s,n)
    s=tostring(s or "")
    if n<=0 then return "" end
    if #s>n then
        if n<=3 then return s:sub(1,n) end
        return s:sub(1,n-3).."..."
    end
    return s..string.rep(" ",n-#s)
end

local function center(y,s,fg,bg)
    s=tostring(s or "")
    if #s>W() then s=fit(s,W()) end
    put(math.max(1,math.floor((W()-#s)/2)+1),y,s,fg,bg)
end

local function box(x1,y1,x2,y2,bg,fg)
    bg=bg or PANEL
    fg=fg or MUTED
    if x2-x1<2 or y2-y1<2 then return end

    for y=y1,y2 do
        put(x1,y,"+"..string.rep("-",x2-x1-1).."+",fg,bg)
        if y>y1 and y<y2 then
            put(x1,y,"|",fg,bg)
            put(x2,y,"|",fg,bg)
            if x2-x1>1 then
                put(x1+1,y,string.rep(" ",x2-x1-1),FG,bg)
            end
        end
    end
end

local function header()
    blank(1,BG)
    put(2,1,"CCI BIOS SETUP UTILITY",WHITE,BG)

    local v="v"..BIOS_VERSION
    put(math.max(2,W()-#v),1,v,WHITE,BG)

    blank(2,BLUE)

    local x=2
    for i,name in ipairs(pages) do
        local t=" "..name.." "
        local bg=(i==page) and PANEL or BLUE
        local fg=(i==page) and FG or WHITE
        if x+#t-1<=W()-1 then
            put(x,2,t,fg,bg)
            x=x+#t+1
        end
    end

    blank(3,BG)

    put(2,3,"CCI BIOS  |  CONFIGURATION",WHITE,BG)

    local date=os.date("%Y-%m-%d %H:%M:%S")
    if #date<W()-24 then
        put(W()-#date-1,3,date,WHITE,BG)
    end
end

local function footer(status)
    local h=H()

    if h<6 then return end

    blank(h-1,SELECT)
    local hints="[←/→] Page  [↑/↓] Select  [Enter] Choose  [F10] Save"
    put(2,h-1,fit(hints,W()-2),WHITE,SELECT)

    blank(h,BLUE)

    local s=status or "Ready"
    put(2,h,"CCI BIOS  |  "..fit(s,math.max(0,W()-15)),WHITE,BLUE)

    local mode="BIOS"
    put(math.max(2,W()-#mode-1),h,mode,WHITE,BLUE)
end

local function title(name,description)
    put(3,5,name,WHITE,BG)
    put(3,6,fit(description,W()-6),WHITE,BG)
end

local function row(y,label,value)
    local labelW=math.min(20,math.max(12,math.floor(W()*0.36)))
    put(5,y,fit(label,labelW),MUTED,PANEL)
    put(6+labelW,y,fit(value,W-(7+labelW)),FG,PANEL)
end

local function computerType()
    if pocket then return "Pocket Computer" end
    if turtle then
        return term.isColor() and "Advanced Turtle" or "Turtle"
    end
    return term.isColor() and "Advanced Computer" or "Computer"
end

local function getBoots()
    local out={}
    for _,v in ipairs(bootCandidates) do
        if fs.exists(v.path) and not fs.isDir(v.path) then
            out[#out+1]=v
        end
    end
    return out
end

local function loadCfg()
    if not fs.exists(CFG) then return end

    local f=fs.open(CFG,"r")
    if not f then return end

    local raw=f.readAll()
    f.close()

    local ok,t=pcall(textutils.unserialize,raw)
    if ok and type(t)=="table" and type(t.boot)=="string" then
        savedBoot=t.boot
    end
end

local function saveCfg()
    local path=selectedBoot
    if not path then
        local boots=getBoots()
        if #boots>0 then path=boots[bootItem].path end
    end

    local f=fs.open(CFG,"w")
    if not f then return false end

    f.write(textutils.serialize({version=1,boot=path}))
    f.close()
    savedBoot=path
    return true
end

local function syncBoot()
    local boots=getBoots()

    if #boots==0 then
        bootItem=1
        selectedBoot=nil
        return
    end

    bootItem=1

    if savedBoot then
        for i,v in ipairs(boots) do
            if v.path==savedBoot then
                bootItem=i
                break
            end
        end
    end

    selectedBoot=boots[bootItem].path
end

local function mainPage()
    local h=H()
    title("Main","System information and current boot configuration")

    local split=math.floor(W()/2)
    local left2=split-1
    local right1=split+1

    if left2>8 then
        box(3,8,left2,h-3,PANEL,MUTED)
        put(5,8,"System",WHITE,SELECT)
        row(10,"Computer",computerType())
        row(12,"Computer ID",tostring(os.getComputerID()))
        row(14,"Display",tostring(W()).." x "..tostring(h))
        row(16,"Colors",term.isColor() and "Enabled" or "Disabled")
        row(18,"Label",os.getComputerLabel() or "Not configured")
    end

    box(right1,8,W()-3,h-3,PANEL,MUTED)
    put(right1+2,8,"Boot",WHITE,SELECT)

    local boots=getBoots()
    row(10,"Devices",tostring(#boots))

    local current
    if #boots>0 then
        bootItem=math.max(1,math.min(bootItem,#boots))
        current=boots[bootItem]
    end

    row(12,"Selected",current and current.path or "None")
    row(14,"Status",current and "Ready" or "No boot file")
    row(16,"Saved",savedBoot or "Default")
    row(18,"Boot mode","#"..tostring(bootItem).." / "..tostring(#boots))

    footer("Main page")
end

local function advancedPage()
    local h=H()
    title("Advanced","Hardware and peripheral information")

    box(3,8,W()-3,h-3,PANEL,MUTED)
    put(5,8,"Hardware",WHITE,SELECT)

    row(10,"Computer type",computerType())
    row(12,"Terminal width",tostring(W()))
    row(14,"Terminal height",tostring(h))
    row(16,"Peripheral count",tostring(#peripheral.getNames()))
    row(18,"CC:Tweaked",_HOST or "Unknown")

    put(5,20,"Detected peripherals",WHITE,SELECT)

    local y=22
    for _,side in ipairs(peripheral.getNames()) do
        if y>=h-4 then break end
        local ptype=peripheral.getType(side) or "unknown"
        put(7,y,fit(side,18),FG,PANEL)
        put(27,y,fit(ptype,math.max(10,W()-29)),MUTED,PANEL)
        y=y+1
    end

    if #peripheral.getNames()==0 then
        put(7,y,"None detected.",MUTED,PANEL)
    end

    footer("Advanced information")
end

local function bootPage()
    local h=H()
    title("Boot","Boot priority order")

    box(3,8,W()-3,h-3,PANEL,MUTED)
    put(5,8,"Boot Priority",WHITE,SELECT)

    local boots=getBoots()

    if #boots==0 then
        center(13,"NO BOOTABLE DEVICE FOUND",RED,PANEL)
        center(15,"Create /startup or another supported boot file.",MUTED,PANEL)
        footer("Boot menu")
        return
    end

    if bootItem>#boots then bootItem=#boots end
    if bootItem<1 then bootItem=1 end

    local maxRows=math.max(1,h-13)
    local first=math.max(1,math.min(bootItem,math.max(1,#boots-maxRows+1)))
    local last=math.min(#boots,first+maxRows-1)

    local y=10

    for i=first,last do
        local v=boots[i]
        local selected=(i==bootItem)
        local bg=selected and BLUE or PANEL
        local fg=selected and WHITE or FG

        fillLine=y,bg,fg,5,W()-5
        put(7,y,(selected and ">" or " ").." "..tostring(i),fg,bg)
        put(13,y,fit(v.name,24),fg,bg)

        local px=39
        if px<W()-4 then
            put(px,y,fit(v.path,W()-px-5),fg,bg)
        end

        y=y+2
    end

    put(5,h-4,"Enter = select boot device",MUTED,PANEL)
    footer("Boot menu")
end

local function securityPage()
    local h=H()
    title("Security","Firmware security status")

    box(3,8,W()-3,h-3,PANEL,MUTED)
    put(5,8,"Security Status",WHITE,SELECT)

    row(10,"Setup password","Not configured")
    row(12,"Boot password","Not configured")
    row(14,"Secure Boot","Unavailable")
    row(16,"Firmware lock","Disabled")
    row(18,"Configuration","Writable")

    put(5,21,"This BIOS only reports features actually implemented.",MUTED,PANEL)
    put(5,22,"No simulated security state is shown.",MUTED,PANEL)

    footer("Security information")
end

local function exitPage()
    local h=H()
    local options={
        "Save Changes & Exit",
        "Discard Changes & Exit",
        "Save Changes",
        "Reboot Computer",
        "Shutdown Computer"
    }

    title("Save & Exit","Apply configuration or leave BIOS Setup")

    box(3,8,W()-3,h-3,PANEL,MUTED)
    put(5,8,"Exit Options",WHITE,SELECT)

    local y=11
    for i,v in ipairs(options) do
        local selected=(i==item)
        local bg=selected and BLUE or PANEL
        local fg=selected and WHITE or FG

        fillLine(y,bg,fg,6,W()-6)
        put(8,y,(selected and ">" or " ").." "..v,fg,bg)
        y=y+2
    end

    if selectedBoot then
        put(5,h-4,"Boot device:",MUTED,PANEL)
        put(18,h-4,fit(selectedBoot,W()-20),FG,PANEL)
    end

    footer("Exit menu")
end

local function draw()
    if H()<12 then
        cls(BG)
        center(5,"CCI BIOS",WHITE,BG)
        center(7,"Terminal too small",YELLOW,BG)
        center(8,"Use a larger Computer or Monitor.",WHITE,BG)
        center(H()-1,"Press any key",MUTED,BG)
        return
    end

    if page==1 then
        cls(BG)
        header()
        mainPage()
    elseif page==2 then
        cls(BG)
        header()
        advancedPage()
    elseif page==3 then
        cls(BG)
        header()
        bootPage()
    elseif page==4 then
        cls(BG)
        header()
        securityPage()
    else
        cls(BG)
        header()
        exitPage()
    end
end

local function message(titleText,textText,color)
    local w,h=W(),H()
    local bw=math.min(48,w-6)
    local bh=6
    local x=math.floor((w-bw)/2)+1
    local y=math.floor((h-bh)/2)

    box(x,y,x+bw-1,y+bh,PANEL,MUTED)
    fillLine(y,BLUE,WHITE,x,x+bw-1)
    centerText=y
    put(x+2,y+2,fit(textText,bw-4),color or FG,PANEL)
    put(x+2,y+4,fit("Press ENTER",bw-4),MUTED,PANEL)

    while true do
        local e,k=os.pullEvent("key")
        if k==keys.enter or k==keys.escape then return end
    end
end

local function setTab(dir)
    page=page+dir
    if page<1 then page=#pages end
    if page>#pages then page=1 end
    item=1
end

local function bootSelected()
    local boots=getBoots()
    if #boots==0 then
        message("Boot Error","No bootable device found.",RED)
        return nil
    end

    bootItem=math.max(1,math.min(bootItem,#boots))
    selectedBoot=boots[bootItem].path
    return selectedBoot
end

local function handleKey(key)
    if key==keys.left then
        setTab(-1)
        return nil
    end

    if key==keys.right or key==keys.tab then
        setTab(1)
        return nil
    end

    if key==keys.f10 then
        saveCfg()
        return "BOOT"
    end

    if page==3 then
        local boots=getBoots()

        if key==keys.up and #boots>0 then
            bootItem=bootItem-1
            if bootItem<1 then bootItem=#boots end
            return nil
        end

        if key==keys.down and #boots>0 then
            bootItem=bootItem+1
            if bootItem>#boots then bootItem=1 end
            return nil
        end

        if key==keys.enter then
            if bootSelected() then
                message("Boot Option",selectedBoot,GREEN)
            end
            return nil
        end

        return nil
    end

    if page==5 then
        if key==keys.up then
            item=item-1
            if item<1 then item=5 end
        elseif key==keys.down then
            item=item+1
            if item>5 then item=1 end
        elseif key==keys.enter then
            if item==1 then
                saveCfg()
                return "BOOT"
            elseif item==2 then
                return "BOOT"
            elseif item==3 then
                if saveCfg() then
                    message("Saved","BIOS configuration saved.",GREEN)
                else
                    message("Save Error","Could not write BIOS configuration.",RED)
                end
            elseif item==4 then
                return "REBOOT"
            elseif item==5 then
                return "SHUTDOWN"
            end
        end

        return nil
    end

    if page==1 and key==keys.enter then
        return bootSelected() and "BOOT" or nil
    end

    return nil
end

local function waitSetup()
    while true do
        draw()

        local event,key=os.pullEvent("key")

        if key==keys.escape then
            page=5
            item=2
        else
            local result=handleKey(key)
            if result then return result end
        end
    end
end

local function post()
    cls(colors.black)

    local w,h=W(),H()

    center(2,"CCI",WHITE,colors.black)
    center(3,"COMPLEX COMPUTER INTERNATIONAL",colors.lightBlue,colors.black)
    center(5,"BIOS INITIALIZATION",WHITE,colors.black)

    local checks={
        "Processor",
        "Memory",
        "Filesystem",
        "Peripherals",
        "Display",
        "Boot devices"
    }

    local y=8

    for i,name in ipairs(checks) do
        put(4,y,name,WHITE,colors.black)

        local ok=true
        if i==6 and #getBoots()==0 then ok=false end

        local s=ok and "[ OK ]" or "[NONE]"
        local c=ok and GREEN or YELLOW

        put(math.max(4,w-11),y,s,c,colors.black)
        y=y+2
        sleep(0.08)
    end

    local barW=math.min(36,math.max(10,w-12))
    local bx=math.floor((w-barW)/2)+1

    for p=0,100,10 do
        local filled=math.floor(barW*p/100)
        put(bx,h-4,"["..string.rep("#",filled)..string.rep(".",barW-filled).."]",colors.lightBlue,colors.black)
        center(h-3,tostring(p).."%",MUTED,colors.black)
        sleep(0.025)
    end
end

local function boot(path)
    cls(colors.black)

    center(7,"CCI BIOS",WHITE,colors.black)
    center(9,"Booting",colors.lightBlue,colors.black)
    center(11,path,WHITE,colors.black)

    local w,h=W(),H()
    local bw=math.min(40,math.max(10,w-8))
    local bx=math.floor((w-bw)/2)+1

    for p=0,100,10 do
        local f=math.floor(bw*p/100)
        put(bx,14,string.rep("=",f)..string.rep("-",bw-f),colors.lightBlue,colors.black)
        center(15,tostring(p).."%",MUTED,colors.black)
        sleep(0.02)
    end

    cls(colors.black)

    local ok,err=pcall(function()
        os.run({},path)
    end)

    if not ok then
        center(6,"BOOT FAILURE",RED,colors.black)
        center(8,"The selected boot program returned an error.",WHITE,colors.black)

        local msg=tostring(err)
        local max=math.max(10,w-6)
        local line=""
        local y=11

        for word in msg:gmatch("%S+") do
            if line=="" then
                line=word
            elseif #line+#word+1<=max then
                line=line.." "..word
            else
                put(3,y,fit(line,max),YELLOW,colors.black)
                y=y+1
                line=word
                if y>=h-3 then break end
            end
        end

        if line~="" and y<h-2 then
            put(3,y,fit(line,max),YELLOW,colors.black)
        end

        center(h-1,"Press ENTER",MUTED,colors.black)

        while true do
            local e,k=os.pullEvent("key")
            if k==keys.enter then break end
        end

        return false
    end

    return true
end

-- Startup
loadCfg()
syncBoot()

post()

local setupRequested=false
local timer=os.startTimer(2.0)

while true do
    local event,value=os.pullEvent()

    if event=="key" then
        if value==keys.delete or value==keys.escape then
            setupRequested=true
            os.cancelTimer(timer)
            break
        end
    elseif event=="char" and value=="]" then
        setupRequested=true
        os.cancelTimer(timer)
        break
    elseif event=="timer" and value==timer then
        break
    end
end

if setupRequested then
    local result=waitSetup()

    if result=="REBOOT" then
        os.reboot()
    elseif result=="SHUTDOWN" then
        os.shutdown()
    elseif result=="BOOT" then
        syncBoot()
        local path=selectedBoot

        if not path then
            local boots=getBoots()
            if #boots>0 then path=boots[bootItem].path end
        end

        if path then
            boot(path)
        else
            cls(colors.black)
            center(9,"NO BOOTABLE DEVICE FOUND",RED,colors.black)
            center(11,"Press ENTER",MUTED,colors.black)
            while true do
                local e,k=os.pullEvent("key")
                if k==keys.enter then break end
            end
        end
    end
else
    syncBoot()
    local path=selectedBoot

    if path then
        boot(path)
    else
        local result=waitSetup()
        if result=="REBOOT" then
            os.reboot()
        elseif result=="SHUTDOWN" then
            os.shutdown()
        elseif result=="BOOT" then
            syncBoot()
            if selectedBoot then boot(selectedBoot) end
        end
    end
end
