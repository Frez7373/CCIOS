-- ============================================================
-- CCI BIOS SETUP UTILITY
-- Clean classic BIOS-style interface for CC:Tweaked
-- Standalone. No external libraries or APIs.
-- ============================================================

local VERSION = "3.0.0"
local CONFIG = "/.cci_bios.cfg"

local pages = {"MAIN", "ADVANCED", "BOOT", "SECURITY", "EXIT"}
local currentPage = 1
local cursor = 1
local bootCursor = 1
local savedBoot = nil
local pendingBoot = nil

local C = {
    blue = colors.blue,
    lightBlue = colors.lightBlue,
    gray = colors.gray,
    lightGray = colors.lightGray,
    white = colors.white,
    black = colors.black,
    yellow = colors.yellow,
    red = colors.red,
    lime = colors.lime
}

local bootCandidates = {
    { path = "/startup", label = "CC:Tweaked startup" },
    { path = "/boot.lua", label = "Boot loader" },
    { path = "/os.lua", label = "Operating system" },
    { path = "/system/startup", label = "System startup" },
    { path = "/system/boot.lua", label = "System boot loader" }
}

local function size()
    return term.getSize()
end

local function fill(y, bg, fg)
    local w = size()
    term.setCursorPos(1, y)
    term.setBackgroundColor(bg)
    term.setTextColor(fg or C.black)
    write(string.rep(" ", w))
end

local function fillRange(x1, y, x2, bg, fg)
    local w = size()
    x1 = math.max(1, math.min(x1, w))
    x2 = math.max(1, math.min(x2, w))
    if x2 < x1 then return end
    term.setCursorPos(x1, y)
    term.setBackgroundColor(bg)
    term.setTextColor(fg or C.black)
    write(string.rep(" ", x2 - x1 + 1))
end

local function text(x, y, value, fg, bg)
    local w = size()

    x = math.max(1, math.min(x, w))
    value = tostring(value or "")

    if #value > w - x + 1 then
        value = value:sub(1, math.max(0, w - x + 1))
    end

    term.setCursorPos(x, y)
    if bg then term.setBackgroundColor(bg) end
    if fg then term.setTextColor(fg) end
    write(value)
end

local function fit(value, width)
    value = tostring(value or "")
    width = math.max(0, width or 0)

    if #value > width then
        if width <= 3 then
            return value:sub(1, width)
        end
        return value:sub(1, width - 3) .. "..."
    end

    return value .. string.rep(" ", width - #value)
end

local function center(y, value, fg, bg)
    local w = size()
    value = tostring(value or "")

    if #value > w then
        value = fit(value, w)
    end

    local x = math.floor((w - #value) / 2) + 1
    text(x, y, value, fg, bg)
end

local function panel(x1, y1, x2, y2, bg, fg)
    local w, h = size()

    x1 = math.max(1, math.min(x1, w))
    x2 = math.max(1, math.min(x2, w))
    y1 = math.max(1, math.min(y1, h))
    y2 = math.max(1, math.min(y2, h))

    if x2 <= x1 or y2 <= y1 then
        return
    end

    bg = bg or C.lightGray
    fg = fg or C.gray

    for y = y1, y2 do
        fillRange(x1, y, x2, bg, C.black)
        if y == y1 or y == y2 then
            text(x1, y, "+" .. string.rep("-", x2 - x1 - 1) .. "+", fg, bg)
        else
            text(x1, y, "|", fg, bg)
            text(x2, y, "|", fg, bg)
        end
    end
end

local function clear(bg)
    term.setBackgroundColor(bg)
    term.setTextColor(C.white)
    term.clear()
    term.setCursorPos(1, 1)
end

local function header()
    local w = size()

    fill(1, C.blue, C.white)
    text(2, 1, "CCI BIOS SETUP UTILITY", C.white, C.blue)

    local v = "v" .. VERSION
    text(math.max(2, w - #v), 1, v, C.white, C.blue)

    fill(2, C.lightBlue, C.black)

    local x = 2

    for i, name in ipairs(pages) do
        local label = " " .. name .. " "
        if x + #label <= w then
            if i == currentPage then
                text(x, 2, label, C.black, C.lightGray)
            else
                text(x, 2, label, C.white, C.lightBlue)
            end
            x = x + #label + 1
        end
    end
end

local function footer(status)
    local w, h = size()

    if h < 4 then
        return
    end

    fill(h - 1, C.gray, C.white)

    local help = "[←][→] Page   [↑][↓] Select   [ENTER] Choose   [F10] Save"
    text(2, h - 1, fit(help, w - 2), C.white, C.gray)

    fill(h, C.blue, C.white)

    local left = "CCI BIOS"
    local right = status or "READY"

    text(2, h, left, C.white, C.blue)
    text(math.max(2, w - #right - 1), h, right, C.yellow, C.blue)
end

local function title(name, description)
    local w, h = size()

    text(3, 4, name, C.white, C.blue)
    text(3, 5, fit(description, w - 6), C.lightBlue, C.blue)

    if h >= 7 then
        fill(6, C.blue, C.white)
    end
end

local function field(x, y, label, value, labelWidth, valueWidth)
    text(x, y, fit(label, labelWidth), C.gray, C.lightGray)
    text(x + labelWidth + 1, y, fit(value, valueWidth), C.black, C.lightGray)
end

local function computerType()
    if pocket then
        return "Pocket Computer"
    end

    if turtle then
        if term.isColor() then
            return "Advanced Turtle"
        end
        return "Turtle"
    end

    if term.isColor() then
        return "Advanced Computer"
    end

    return "Computer"
end

local function bootEntries()
    local result = {}

    for _, entry in ipairs(bootCandidates) do
        if fs.exists(entry.path) and not fs.isDir(entry.path) then
            result[#result + 1] = entry
        end
    end

    return result
end

local function loadConfig()
    savedBoot = nil

    if not fs.exists(CONFIG) then
        return
    end

    local h = fs.open(CONFIG, "r")
    if not h then
        return
    end

    local raw = h.readAll()
    h.close()

    local ok, data = pcall(textutils.unserialize, raw)

    if ok and type(data) == "table" and type(data.boot) == "string" then
        savedBoot = data.boot
    end
end

local function saveConfig()
    local entries = bootEntries()
    local path = pendingBoot

    if not path and #entries > 0 then
        path = entries[bootCursor].path
    end

    if not path then
        return false
    end

    local h = fs.open(CONFIG, "w")
    if not h then
        return false
    end

    h.write(textutils.serialize({
        version = 1,
        boot = path
    }))

    h.close()
    savedBoot = path
    return true
end

local function syncBootCursor()
    local entries = bootEntries()

    if #entries == 0 then
        bootCursor = 1
        pendingBoot = nil
        return
    end

    bootCursor = 1

    if savedBoot then
        for i, entry in ipairs(entries) do
            if entry.path == savedBoot then
                bootCursor = i
                break
            end
        end
    end

    pendingBoot = entries[bootCursor].path
end

local function mainPage()
    local w, h = size()

    title("MAIN", "System overview and boot status")

    if w < 44 or h < 16 then
        panel(3, 8, w - 3, h - 3)

        text(5, 8, "SYSTEM", C.white, C.gray)

        local y = 10
        field(5, y, "Type", computerType(), 13, w - 20)
        y = y + 2
        field(5, y, "ID", os.getComputerID(), 13, w - 20)
        y = y + 2
        field(5, y, "Display", tostring(w) .. " x " .. tostring(h), 13, w - 20)
        y = y + 2
        field(5, y, "Label", os.getComputerLabel() or "Not configured", 13, w - 20)

        footer("MAIN")
        return
    end

    local mid = math.floor(w / 2)

    panel(3, 8, mid - 1, h - 3)
    panel(mid + 1, 8, w - 3, h - 3)

    text(5, 8, "SYSTEM INFORMATION", C.white, C.gray)
    text(mid + 3, 8, "BOOT STATUS", C.white, C.gray)

    field(5, 10, "Computer", computerType(), 14, math.max(1, mid - 21))
    field(5, 12, "Computer ID", os.getComputerID(), 14, math.max(1, mid - 21))
    field(5, 14, "Display", tostring(w) .. " x " .. tostring(h), 14, math.max(1, mid - 21))

    local entries = bootEntries()
    local selected = entries[bootCursor]

    field(mid + 3, 10, "Boot entries", #entries, 14, math.max(1, w - mid - 21))
    field(mid + 3, 12, "Mode", #entries > 0 and "NORMAL" or "NONE", 14, math.max(1, w - mid - 21))
    field(mid + 3, 14, "Selected", selected and selected.path or "None", 14, math.max(1, w - mid - 21))

    footer("MAIN")
end

local function advancedPage()
    local w, h = size()

    title("ADVANCED", "Hardware and peripheral information")
    panel(3, 8, w - 3, h - 3)

    text(5, 8, "HARDWARE", C.white, C.gray)

    field(5, 10, "Computer type", computerType(), 18, math.max(1, w - 27))
    field(5, 12, "Color support", term.isColor() and "AVAILABLE" or "UNAVAILABLE", 18, math.max(1, w - 27))
    field(5, 14, "Terminal width", w, 18, math.max(1, w - 27))
    field(5, 16, "Terminal height", h, 18, math.max(1, w - 27))

    if h >= 22 then
        text(5, 20, "PERIPHERALS", C.white, C.gray)

        local y = 21
        for _, side in ipairs(peripheral.getNames()) do
            if y >= h - 3 then
                break
            end

            text(7, y, fit(side, 18), C.black, C.lightGray)
            text(27, y, fit(peripheral.getType(side) or "unknown", math.max(1, w - 28)), C.gray, C.lightGray)
            y = y + 1
        end

        if #peripheral.getNames() == 0 then
            text(7, y, "None detected.", C.gray, C.lightGray)
        end
    end

    footer("ADVANCED")
end

local function bootPage()
    local w, h = size()
    local entries = bootEntries()

    title("BOOT", "Boot device priority")

    panel(3, 8, w - 3, h - 3)
    text(5, 8, "BOOT PRIORITY", C.white, C.gray)

    if #entries == 0 then
        center(12, "NO BOOTABLE DEVICE FOUND", C.red, C.lightGray)
        center(14, "Create /startup, /boot.lua or /os.lua", C.gray, C.lightGray)
        footer("BOOT")
        return
    end

    if bootCursor < 1 then bootCursor = #entries end
    if bootCursor > #entries then bootCursor = 1 end

    local available = math.max(1, math.floor((h - 11) / 2))
    local first = math.max(1, math.min(bootCursor, math.max(1, #entries - available + 1)))
    local last = math.min(#entries, first + available - 1)

    local y = 10

    for i = first, last do
        local entry = entries[i]
        local selected = i == bootCursor
        local bg = selected and C.blue or C.lightGray
        local fg = selected and C.white or C.black

        fill(y, bg, fg)
        text(6, y, selected and ">" or " ", fg, bg)
        text(8, y, fit(tostring(i), 3), fg, bg)
        text(13, y, fit(entry.label, 22), fg, bg)

        local pathX = 37
        if pathX < w - 2 then
            text(pathX, y, fit(entry.path, w - pathX - 2), C.lightBlue, bg)
        end

        y = y + 2
    end

    if h >= 15 then
        text(5, h - 4, "ENTER = select this boot device", C.gray, C.lightGray)
    end

    footer("BOOT")
end

local function securityPage()
    local w, h = size()

    title("SECURITY", "Firmware security status")
    panel(3, 8, w - 3, h - 3)

    text(5, 8, "SECURITY STATUS", C.white, C.gray)

    field(5, 10, "Setup password", "NOT CONFIGURED", 19, math.max(1, w - 28))
    field(5, 12, "Boot password", "NOT CONFIGURED", 19, math.max(1, w - 28))
    field(5, 14, "Secure Boot", "NOT AVAILABLE", 19, math.max(1, w - 28))
    field(5, 16, "Firmware lock", "DISABLED", 19, math.max(1, w - 28))

    if h >= 21 then
        text(5, h - 4, "This page reports only features implemented by this BIOS.", C.gray, C.lightGray)
    end

    footer("SECURITY")
end

local function exitPage()
    local w, h = size()

    local options = {
        "Save Changes & Exit",
        "Discard Changes & Exit",
        "Save Changes",
        "Reboot Computer",
        "Shutdown Computer"
    }

    title("SAVE & EXIT", "Apply configuration or leave BIOS Setup")
    panel(3, 8, w - 3, h - 3)

    text(5, 8, "EXIT OPTIONS", C.white, C.gray)

    local y = 10

    for i, option in ipairs(options) do
        if y >= h - 3 then
            break
        end
        local selected = i == cursor
        local bg = selected and C.blue or C.lightGray
        local fg = selected and C.white or C.black

        fill(y, bg, fg)
        text(7, y, selected and ">" or " ", fg, bg)
        text(9, y, fit(option, w - 12), fg, bg)
        y = y + 1
    end

    footer("EXIT")
end

local function draw()
    clear(C.blue)

    local w, h = size()

    if w < 30 or h < 12 then
        center(math.max(2, math.floor(h / 2) - 1), "CCI BIOS", C.white, C.blue)
        center(math.max(4, math.floor(h / 2) + 1), "Terminal too small", C.yellow, C.blue)
        center(math.max(6, math.floor(h / 2) + 2), tostring(w) .. " x " .. tostring(h), C.white, C.blue)
        return
    end

    header()

    if currentPage == 1 then
        mainPage()
    elseif currentPage == 2 then
        advancedPage()
    elseif currentPage == 3 then
        bootPage()
    elseif currentPage == 4 then
        securityPage()
    else
        exitPage()
    end
end

local function message(titleText, body, color)
    local w, h = size()

    local boxW = math.min(46, w - 6)
    local boxH = 6

    if boxW < 18 or h < 10 then
        clear(C.black)
        center(math.max(2, math.floor(h / 2) - 1), titleText, color or C.white, C.black)
        center(math.max(4, math.floor(h / 2) + 1), body, C.white, C.black)

        while true do
            local event, key = os.pullEvent("key")
            if key == keys.enter or key == keys.escape then
                return
            end
        end
    end

    local x = math.floor((w - boxW) / 2) + 1
    local y = math.floor((h - boxH) / 2)

    panel(x, y, x + boxW - 1, y + boxH)
    fill(y, C.blue, C.white)
    text(x + 2, y + 2, fit(body, boxW - 4), color or C.black, C.lightGray)
    text(x + 2, y + 4, "Press ENTER", C.gray, C.lightGray)

    while true do
        local event, key = os.pullEvent("key")
        if key == keys.enter or key == keys.escape then
            return
        end
    end
end

local function nextPage(delta)
    currentPage = currentPage + delta

    if currentPage < 1 then
        currentPage = #pages
    elseif currentPage > #pages then
        currentPage = 1
    end

    cursor = 1
end

local function handleKey(key)
    if key == keys.left then
        nextPage(-1)
        return nil
    end

    if key == keys.right or key == keys.tab then
        nextPage(1)
        return nil
    end

    if key == keys.f10 then
        saveConfig()
        return "BOOT"
    end

    if currentPage == 3 then
        local entries = bootEntries()

        if key == keys.up and #entries > 0 then
            bootCursor = bootCursor - 1
            if bootCursor < 1 then
                bootCursor = #entries
            end
            pendingBoot = entries[bootCursor].path
            return nil
        end

        if key == keys.down and #entries > 0 then
            bootCursor = bootCursor + 1
            if bootCursor > #entries then
                bootCursor = 1
            end
            pendingBoot = entries[bootCursor].path
            return nil
        end

        if key == keys.enter and #entries > 0 then
            pendingBoot = entries[bootCursor].path
            message("BOOT DEVICE SELECTED", pendingBoot, C.lime)
            return nil
        end

        return nil
    end

    if currentPage == 5 then
        if key == keys.up then
            cursor = cursor - 1
            if cursor < 1 then cursor = 5 end
            return nil
        end

        if key == keys.down then
            cursor = cursor + 1
            if cursor > 5 then cursor = 1 end
            return nil
        end

        if key == keys.enter then
            if cursor == 1 then
                if saveConfig() then
                    return "BOOT"
                end
                message("SAVE ERROR", "Unable to write BIOS configuration.", C.red)
                return nil
            elseif cursor == 2 then
                return "BOOT"
            elseif cursor == 3 then
                if saveConfig() then
                    message("SAVED", "BIOS configuration saved.", C.lime)
                else
                    message("SAVE ERROR", "Unable to write BIOS configuration.", C.red)
                end
                return nil
            elseif cursor == 4 then
                return "REBOOT"
            elseif cursor == 5 then
                return "SHUTDOWN"
            end
        end

        return nil
    end

    if key == keys.enter then
        if currentPage == 1 then
            currentPage = 3
            cursor = 1
        elseif currentPage == 2 then
            currentPage = 1
            cursor = 1
        elseif currentPage == 4 then
            currentPage = 5
            cursor = 1
        end
    end

    return nil
end

local function setup()
    while true do
        draw()

        local event, key = os.pullEvent("key")

        if key == keys.escape then
            currentPage = 5
            cursor = 2
        else
            local result = handleKey(key)

            if result then
                return result
            end
        end
    end
end

local function post()
    local w, h = size()

    clear(C.black)

    center(2, "CCI", C.white, C.black)
    center(3, "COMPLEX COMPUTER INTERNATIONAL", C.lightBlue, C.black)
    center(5, "BIOS POWER-ON SELF TEST", C.white, C.black)

    local checks = {
        "Processor",
        "Memory",
        "Filesystem",
        "Peripherals",
        "Display",
        "Boot devices"
    }

    local y = math.max(7, math.floor(h / 3))

    for i, name in ipairs(checks) do
        if y < h - 4 then
            text(4, y, fit(name, math.max(12, w - 16)), C.white, C.black)

            local ok = true
            if i == #checks and #bootEntries() == 0 then
                ok = false
            end

            text(math.max(4, w - 10), y, ok and "[ OK ]" or "[NONE]", ok and C.lime or C.yellow, C.black)
            y = y + 1
        end
        sleep(0.05)
    end

    if h >= 8 then
        local hint = "Press [DEL] / [ESC] / ] for BIOS Setup"
        center(h - 2, hint, C.gray, C.black)
    end

    sleep(0.5)
end

local function executeBoot(path)
    local w, h = size()

    clear(C.black)

    center(6, "CCI BIOS", C.white, C.black)
    center(8, "Starting boot device", C.lightBlue, C.black)
    center(10, path, C.white, C.black)

    local barW = math.min(38, math.max(10, w - 8))
    local x = math.floor((w - barW) / 2) + 1

    for percent = 0, 100, 10 do
        local filled = math.floor(barW * percent / 100)
        text(x, 13, string.rep("=", filled) .. string.rep("-", barW - filled), C.lightBlue, C.black)
        center(14, percent .. "%", C.gray, C.black)
        sleep(0.02)
    end

    clear(C.black)

    local ok, err = pcall(function()
        os.run({}, path)
    end)

    if ok then
        return true
    end

    local maxWidth = math.max(10, w - 6)
    local messageText = tostring(err)
    local line = ""
    local y = 8

    center(4, "BOOT FAILURE", C.red, C.black)

    for word in messageText:gmatch("%S+") do
        if line == "" then
            line = word
        elseif #line + #word + 1 <= maxWidth then
            line = line .. " " .. word
        else
            text(3, y, fit(line, maxWidth), C.yellow, C.black)
            y = y + 1
            line = word

            if y >= h - 3 then
                break
            end
        end
    end

    if line ~= "" and y < h - 2 then
        text(3, y, fit(line, maxWidth), C.yellow, C.black)
    end

    center(h - 1, "Press ENTER", C.gray, C.black)

    while true do
        local event, key = os.pullEvent("key")
        if key == keys.enter then
            return false
        end
    end
end

-- ============================================================
-- Startup
-- ============================================================

loadConfig()
syncBootCursor()

post()

local enterSetup = false
local timer = os.startTimer(1.8)

while true do
    local event, value = os.pullEvent()

    if event == "key" then
        if value == keys.delete or value == keys.escape then
            enterSetup = true
            os.cancelTimer(timer)
            break
        end
    elseif event == "char" and value == "]" then
        enterSetup = true
        os.cancelTimer(timer)
        break
    elseif event == "timer" and value == timer then
        break
    end
end

syncBootCursor()

if enterSetup then
    local result = setup()

    if result == "REBOOT" then
        os.reboot()
    elseif result == "SHUTDOWN" then
        os.shutdown()
    elseif result == "BOOT" then
        syncBootCursor()

        local path = pendingBoot

        if path then
            executeBoot(path)
        else
            center(10, "NO BOOTABLE DEVICE", C.red, C.black)
            center(12, "Press ENTER", C.gray, C.black)
            while true do
                local event, key = os.pullEvent("key")
                if key == keys.enter then break end
            end
        end
    end
else
    syncBootCursor()

    if pendingBoot then
        executeBoot(pendingBoot)
    else
        local result = setup()

        if result == "REBOOT" then
            os.reboot()
        elseif result == "SHUTDOWN" then
            os.shutdown()
        elseif result == "BOOT" and pendingBoot then
            executeBoot(pendingBoot)
        end
    end
end
